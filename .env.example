# Option 1: Google Gemini API Key (Get at https://aistudio.google.com/app/apikey)
# Note: Use a personal @gmail.com account, as university/workspace accounts often block AI Studio.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GCP_API_KEY

# Option 2: Groq Cloud API Key - 100% Free & Instant (Get at https://console.groq.com/keys)
# No credit card required, works in 10 seconds!
GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here
